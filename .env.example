# Plaid credentials
# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret
PLAID_ENV=sandbox

# Required for production/development OAuth flows
# Must be registered in Plaid dashboard under Allowed redirect URIs
# PLAID_REDIRECT_URI=https://yourdomain.com/plaid-oauth-callback

# Optional: webhook URL for async updates
# PLAID_WEBHOOK_URL=https://yourdomain.com/api/plaid-webhook
