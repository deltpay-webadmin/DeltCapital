# Copy this file's keys into your Vercel Environment Variables
# (Project → Settings → Environment Variables). Do NOT commit a filled-in
# .env — see .gitignore. Real secrets only live in Vercel.

# ─── Supabase (shared "Delt Pay Database" project) ─────────────────
# Delt Capital shares the Delt Pay Supabase project so platform users
# (auth.users) are shared across both products. Delt Capital's tables live
# in the `delt_capital` schema and are reached through `public` views — see
# docs/SUPABASE_SCHEMA.sql. Point these at the Delt Pay Database project:
#   Supabase → Delt Pay Database → Project Settings → Data API / API Keys.
SUPABASE_URL=https://ytemrmpnwmzqeradbeoa.supabase.co
# service_role key — server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Plaid ─────────────────────────────────────────────────────────
# From dashboard.plaid.com → Team Settings → Keys.
PLAID_CLIENT_ID=
# Match this secret to PLAID_ENV — Plaid issues a separate secret per env.
PLAID_SECRET=
# Literal value: sandbox | development | production  (NOT a hex string)
PLAID_ENV=sandbox
# From dashboard.plaid.com → Identity Verification → Templates.
# Template IDs are env-scoped — use the one created in the same env as PLAID_SECRET.
PLAID_IDV_TEMPLATE_ID=
# Comma-separated. Production accounts often only have `auth` enabled by default.
PLAID_PRODUCTS=auth,transactions
PLAID_COUNTRY_CODES=US

# ─── Microsoft Graph (Outlook calendar booking) ────────────────────
# From Azure AD app registration. See api/book.js for required Graph permissions.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Mailbox the emails AND calendar invites are sent from (e.g. noreply@deltpay.com).
OUTLOOK_FROM_EMAIL=
# Internal recipient + BCC on booker email; defaults to david@deltpay.com.
BOOKING_NOTIFY_EMAIL=
# Windows timezone name; defaults to "Eastern Standard Time".
BOOKING_TIMEZONE=Eastern Standard Time
# Optional overrides — see api/book.js header comment for when to set.
OUTLOOK_CALENDAR_USER=
OUTLOOK_TEAMS_HOST=
OUTLOOK_AVAILABILITY_USER=
